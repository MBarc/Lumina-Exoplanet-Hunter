# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# MongoDB connection string.
# Local Docker:    mongodb://mongo:27017
# AWS DocumentDB:  mongodb://user:pass@your-cluster.cluster-xxx.us-east-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=global-bundle.pem
# MongoDB Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URI=mongodb://mongo:27017

# Database name
MONGODB_DB=lumina

# Operator key for admin routes (queue populate, scheduler). Nodes never see it.
# Required: the API refuses to start with an empty or default key.
# Generate a strong key: openssl rand -hex 32
API_KEY=

# Nodes join with this invite token (installer --enroll-token). Empty = nobody can join,
# unless OPEN_ENROLLMENT=true lets anyone enroll.
ENROLL_TOKEN=
OPEN_ENROLLMENT=false

# Local test stacks only: allow starting without a real API_KEY.
# ALLOW_INSECURE_DEV=true
